def task():
    tasks = [] 
    print("-----WELCOME TO TASK MANAGMENT SYSTEM-----")

    total_task = int(input("Enter How Many Task You want to 'ADD' = "))

    for i in range(1 , total_task+1):
        task_name = input(f"Enter Your Task {i} = ")
        tasks.append(task_name)

    print(f"Today's Task are :- \n{tasks} ")

    while True:
        operation = int(input("ENTER 1:- Add\n2:- UPDATE\n3:- Delete\n4:- Exit/Stop\n"))

        if operation == 1:
            add = input("Enter Your New Task = ")
            tasks.append(add)
            print(f"Your New Task {add} is Added")
            print(tasks)

        elif operation ==2:
            updated_val = input("Enter Your Task Name That You want to Update = ")
            
            if updated_val in tasks:
                changed_val = input("Enter Your New Task Name = ")
                ind = tasks.index(updated_val)
                tasks[ind] = changed_val
                print(f"Updated Task is {changed_val}")
                print(tasks)

        elif operation == 3:
            Deleted_task = input("Enter Your Task for DELETE = ")
            
            if Deleted_task in tasks:
                ind = tasks.index(Deleted_task)
                del tasks[ind]
                print(f"Your Task {Deleted_task} Has Been Deleted")
                print(tasks)

        elif operation == 4:
            print("-_-_-_-Program ENDED !-_-_-_-")
            break

        else:
            print("Enter Valid Value To Perform Task")

task()


